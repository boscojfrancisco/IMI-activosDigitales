#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 1 || ! "$1" =~ ^[a-f0-9]{40}$ ]]; then
  echo "Expected one full commit SHA" >&2
  exit 64
fi

revision=$1
app_dir=/home/ubuntu/ipecd-infra/apps/front/imi-activos
export PATH=/home/ubuntu/.nvm/versions/node/v20.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

exec 9>/tmp/imi-activos-deploy.lock
if ! /usr/bin/flock -n 9; then
  echo "Another IMI Activos deployment is already running" >&2
  exit 75
fi

cd "$app_dir"
if [[ -n "$(/usr/bin/git status --porcelain)" ]]; then
  echo "Deployment stopped: the EC2 checkout has local changes" >&2
  exit 1
fi

/usr/bin/git fetch --quiet origin main
main_revision=$(/usr/bin/git rev-parse origin/main)
if [[ "$revision" != "$main_revision" ]]; then
  echo "Deployment stopped: requested revision is not the current main tip" >&2
  exit 1
fi

previous_revision=$(/usr/bin/git rev-parse HEAD)
backup_dir=''
reload_attempted=0

rollback() {
  result=$?
  trap - EXIT
  if [[ $result -ne 0 ]]; then
    echo "Deployment failed; restoring $previous_revision" >&2
    if [[ -n "$backup_dir" && -d "$backup_dir/dist" ]]; then
      /usr/bin/rm -rf -- "$app_dir/dist"
      /usr/bin/cp -a -- "$backup_dir/dist" "$app_dir/dist"
    fi
    /usr/bin/git -C "$app_dir" reset --hard "$previous_revision" >/dev/null || true
    /usr/bin/npm --prefix "$app_dir" ci --no-audit --no-fund || true
    if [[ $reload_attempted -eq 1 ]]; then
      /home/ubuntu/.nvm/versions/node/v20.20.0/bin/pm2 reload imi-activos || true
    fi
  fi
  if [[ -n "$backup_dir" ]]; then
    /usr/bin/rm -rf -- "$backup_dir"
  fi
  exit "$result"
}
trap rollback EXIT

/usr/bin/git checkout --quiet main
/usr/bin/git reset --hard "$revision" >/dev/null
/usr/bin/npm ci --no-audit --no-fund

backup_dir=$(/usr/bin/mktemp -d /tmp/imi-activos-backup.XXXXXXXX)
/usr/bin/cp -a -- "$app_dir/dist" "$backup_dir/dist"
/usr/bin/npm --prefix "$app_dir" run build

reload_attempted=1
/home/ubuntu/.nvm/versions/node/v20.20.0/bin/pm2 reload imi-activos

healthy=0
for attempt in {1..12}; do
  if /usr/bin/curl --fail --silent --show-error --max-time 4 http://127.0.0.1:3003/ >/dev/null; then
    healthy=1
    break
  fi
  /usr/bin/sleep 2
done

if [[ $healthy -ne 1 ]]; then
  echo "Deployment health check failed" >&2
  exit 1
fi

echo "Deployed $revision; local health check passed"
