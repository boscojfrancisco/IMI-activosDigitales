#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 1 || ! "$1" =~ ^[a-f0-9]{40}$ ]]; then
  echo "Expected one full commit SHA" >&2
  exit 64
fi

revision=$1
app_dir=/home/ubuntu/ipecd-infra/apps/front/imi-activos
export PATH=/home/ubuntu/.nvm/versions/node/v20.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

exec 9>/tmp/imi-activos-deploy.lock
if ! /usr/bin/flock -n 9; then
  echo "Another IMI Activos deployment is already running" >&2
  exit 75
fi

cd "$app_dir"
if [[ -n "$(/usr/bin/git status --porcelain)" ]]; then
  echo "Deployment stopped: the EC2 checkout has local changes" >&2
  exit 1
fi

/usr/bin/git fetch --quiet origin main
main_revision=$(/usr/bin/git rev-parse origin/main)
if [[ "$revision" != "$main_revision" ]]; then
  echo "Deployment stopped: requested revision is not the current main tip" >&2
  exit 1
fi

previous_revision=$(/usr/bin/git rev-parse HEAD)
if [[ ! -f "$app_dir/ops/identidad/README.md" ]] &&
   /usr/bin/git cat-file -e "$revision:ops/identidad/README.md" 2>/dev/null &&
   [[ "${IMI_GUARDED_CUT:-}" != si ]]; then
  echo "First identity deployment requires the guarded cut procedure" >&2
  exit 1
fi
backup_dir=''
reload_attempted=0

rollback() {
  result=$?
  trap - EXIT
  rollback_failed=0
  if [[ $result -ne 0 ]]; then
    echo "Deployment failed; restoring $previous_revision" >&2
    if [[ -n "$backup_dir" && -d "$backup_dir/dist" ]]; then
      if ! /usr/bin/rm -rf -- "$app_dir/dist" || ! /usr/bin/cp -a -- "$backup_dir/dist" "$app_dir/dist"; then
        echo "Rollback failed: could not restore the previous build" >&2
        rollback_failed=1
      fi
    fi
    if ! /usr/bin/git -C "$app_dir" reset --hard "$previous_revision" >/dev/null; then
      echo "Rollback failed: could not restore the previous revision" >&2
      rollback_failed=1
    fi
    if ! /usr/bin/npm --prefix "$app_dir" ci --no-audit --no-fund; then
      echo "Rollback failed: could not restore the previous dependencies" >&2
      rollback_failed=1
    fi
    if [[ $reload_attempted -eq 1 ]]; then
      if ! /usr/local/bin/pm2 reload imi-activos; then
        echo "Rollback failed: could not reload the previous application" >&2
        rollback_failed=1
      fi
    fi
  fi
  if [[ $rollback_failed -ne 0 && -n "$backup_dir" ]]; then
    echo "Preserving deployment backup for manual recovery: $backup_dir" >&2
  elif [[ -n "$backup_dir" ]]; then
    /usr/bin/rm -rf -- "$backup_dir"
  fi
  exit "$result"
}
trap rollback EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

/usr/bin/git checkout --quiet main
/usr/bin/git reset --hard "$revision" >/dev/null
/usr/bin/npm ci --no-audit --no-fund

backup_dir=$(/usr/bin/mktemp -d /tmp/imi-activos-backup.XXXXXXXX)
/usr/bin/cp -a -- "$app_dir/dist" "$backup_dir/dist"
/usr/bin/npm --prefix "$app_dir" run build

reload_attempted=1
/usr/local/bin/pm2 reload imi-activos

healthy=0
for attempt in {1..12}; do
  if /usr/bin/curl --fail --silent --show-error --max-time 4 http://127.0.0.1:3003/ >/dev/null &&
     { [[ ! -f "$app_dir/ops/identidad/README.md" ]] ||
       /usr/bin/curl --fail --silent --show-error --max-time 4 http://127.0.0.1:3003/api/health | /usr/bin/grep -Fq '"servicio":"imi-activos-identidad","estado":"ok"'; }; then
    healthy=1
    break
  fi
  /usr/bin/sleep 2
done

if [[ $healthy -ne 1 ]]; then
  echo "Deployment health check failed" >&2
  exit 1
fi

if [[ "${IMI_GUARDED_CUT:-}" == si ]]; then
  # File descriptors 3 and 4 are private pipes from the cut supervisor.
  # Until the supervisor confirms the lock and verification, EXIT restores
  # the previous build if the supervisor disappears or the pipe times out.
  printf 'READY\n' >&3
  decision=''
  if ! IFS= read -r -t 60 decision <&4 || [[ "$decision" != COMMIT ]]; then
    echo "Guarded cut was not confirmed; rolling back" >&2
    exit 1
  fi
fi

echo "Deployed $revision; local health check passed"
